{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
      
    ],
    "rewrites": [
      {
        "source": "/submundo",
        "destination": "/submundo/index.html"
      },
      {
        "source": "/submundo/**",
        "destination": "/submundo/index.html"
      }
    ]
  }
}
